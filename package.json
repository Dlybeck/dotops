{
  "name": "codex-dot-connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local native chat coordination, context delivery, recovery and bounded history connector.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "test": "node --test --test-timeout=15000 test/*.test.mjs",
    "build:macos-helper": "node scripts/build-macos-helper.mjs",
    "test:macos-store": "node --test --test-timeout=15000 test/platform/*.test.mjs",
    "probe": "node src/server.mjs",
    "start": "node src/server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dlybeck/dotops.git"
  },
  "homepage": "https://github.com/Dlybeck/dotops#readme",
  "bugs": {
    "url": "https://github.com/Dlybeck/dotops/issues"
  }
}
